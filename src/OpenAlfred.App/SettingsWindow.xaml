<ui:FluentWindow x:Class="OpenAlfred.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="openAlfred 设置"
        Icon="pack://application:,,,/assets/app.ico"
        Width="420" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Topmost="True" ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI">

    <StackPanel Margin="24,48,24,24">
        <TextBlock Text="设置" FontSize="24" FontWeight="Bold" Margin="0,0,0,18" />

        <!-- 常规 -->
        <TextBlock Text="常规" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,8"
                   Foreground="{DynamicResource OaTextSecondaryBrush}" />
        <ComboBox x:Name="ThemeBox" Width="372" HorizontalAlignment="Left" Margin="0,0,0,4" />
        <TextBlock Text="外观主题" FontSize="12"
                   Foreground="{DynamicResource OaTextSecondaryBrush}" Margin="2,0,0,12" />
        <CheckBox x:Name="HideOnLostFocusBox" Content="失去焦点时自动隐藏窗口" Margin="0,0,0,18" />

        <!-- 后台与启动 -->
        <TextBlock Text="后台与启动" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,8"
                   Foreground="{DynamicResource OaTextSecondaryBrush}" />
        <CheckBox x:Name="MinimizeToTrayBox" Content="最小化时收进系统托盘（常驻后台，不退出）" Margin="0,0,0,10" />
        <CheckBox x:Name="StartMinimizedBox" Content="启动后直接最小化到托盘，不弹出窗口" Margin="0,0,0,10" />
        <CheckBox x:Name="TrayTipBox" Content="收进托盘时显示一次气泡提示" Margin="0,0,0,10" />
        <CheckBox x:Name="StartupBox" Content="登录 Windows 时自动启动" Margin="0,0,0,18" />

        <!-- 全局唤起快捷键 -->
        <TextBlock Text="全局唤起快捷键" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,8"
                   Foreground="{DynamicResource OaTextSecondaryBrush}" />
        <DockPanel LastChildFill="True" Margin="0,0,0,4">
            <ui:Button x:Name="ResetHotkeyButton" Content="恢复默认" Appearance="Secondary"
                       DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,5" Visibility="Hidden" />
            <ui:Button x:Name="RecordHotkeyButton" Content="修改…" Appearance="Primary"
                       DockPanel.Dock="Right" Padding="14,5" />
            <Border Background="{DynamicResource OaFooterBrush}" CornerRadius="8"
                    Padding="12,7" VerticalAlignment="Stretch">
                <TextBlock x:Name="HotkeyText" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Border>
        </DockPanel>
        <Grid Margin="2,0,0,18">
            <TextBlock x:Name="HotkeyIdleHint" FontSize="12"
                       Foreground="{DynamicResource OaTextSecondaryBrush}"
                       Text="点击「修改…」后按下新组合键，Esc 取消" />
            <TextBlock x:Name="HotkeyErrorHint" FontSize="12" Visibility="Collapsed"
                       Foreground="#FF3B30" TextWrapping="Wrap" />
        </Grid>

        <!-- 剪贴板 -->
        <TextBlock Text="剪贴板" FontSize="13" FontWeight="SemiBold" Margin="2,0,0,8"
                   Foreground="{DynamicResource OaTextSecondaryBrush}" />
        <CheckBox x:Name="ClipboardPauseBox" Content="暂停剪贴板历史记录" Margin="0,0,0,12" />

        <!-- 剪贴板历史直达快捷键 -->
        <TextBlock Text="剪贴板历史快捷键（一键打开）" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,6"
                   Foreground="{DynamicResource OaTextSecondaryBrush}" />
        <DockPanel LastChildFill="True" Margin="0,0,0,4">
            <ui:Button x:Name="ClipResetButton" Content="恢复默认" Appearance="Secondary"
                       DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,5" Visibility="Hidden" />
            <ui:Button x:Name="ClipRecordButton" Content="修改…" Appearance="Primary"
                       DockPanel.Dock="Right" Padding="14,5" />
            <Border Background="{DynamicResource OaFooterBrush}" CornerRadius="8"
                    Padding="12,7" VerticalAlignment="Stretch">
                <TextBlock x:Name="ClipHotkeyText" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Border>
        </DockPanel>
        <Grid Margin="2,0,0,12">
            <TextBlock x:Name="ClipIdleHint" FontSize="12"
                       Foreground="{DynamicResource OaTextSecondaryBrush}"
                       Text="按下后直接弹出剪贴板历史，输入关键词即可搜索" />
            <TextBlock x:Name="ClipErrorHint" FontSize="12" Visibility="Collapsed"
                       Foreground="#FF3B30" TextWrapping="Wrap" />
        </Grid>

        <ui:Button x:Name="ClearClipboardButton" Content="清除剪贴板历史" Appearance="Secondary"
                   HorizontalAlignment="Left" Margin="0,0,0,18" />

        <Border Height="1" Background="{DynamicResource OaSeparatorBrush}" Margin="0,0,0,14" />
        <TextBlock FontSize="12"
                   Foreground="{DynamicResource OaTextSecondaryBrush}"
                   Text="数据存储于 %APPDATA%\openAlfred" />
    </StackPanel>
</ui:FluentWindow>
