<Application x:Class="OpenAlfred.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:conv="clr-namespace:OpenAlfred.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <ResourceDictionary x:Name="TokenDictionary" Source="Themes/Tokens.Light.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:NullToVisibilityConverter x:Key="StringToVisibilityConverter" />

            <!-- 托盘图标：蓝底圆角 + 白色放大镜 -->
            <DrawingImage x:Key="TrayIcon">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="#007AFF">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,32,32" RadiusX="8" RadiusY="8" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="Transparent">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <EllipseGeometry Center="14,14" RadiusX="6" RadiusY="6" />
                                    <LineGeometry StartPoint="18.5,18.5" EndPoint="24,24" />
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                            <GeometryDrawing.Pen>
                                <Pen Brush="#FFFFFFFF" Thickness="2.6" StartLineCap="Round" EndLineCap="Round" />
                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>
        </ResourceDictionary>
    </Application.Resources>
</Application>
