<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- openAlfred 深色设计令牌（对应 docs/design.md 2.1） -->
    <SolidColorBrush x:Key="OaAccentBrush" Color="#409CFF" />
    <SolidColorBrush x:Key="OaTextPrimaryBrush" Color="#F2F2F7" />
    <SolidColorBrush x:Key="OaTextSecondaryBrush" Color="#98989F" />
    <SolidColorBrush x:Key="OaTextTertiaryBrush" Color="#636366" />
    <SolidColorBrush x:Key="OaWindowBrush" Color="#DB26262E" />
    <SolidColorBrush x:Key="OaWindowBorderBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="OaSelectedBrush" Color="#380A84FF" />
    <SolidColorBrush x:Key="OaHoverBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="OaSeparatorBrush" Color="#19FFFFFF" />
    <SolidColorBrush x:Key="OaPillBrush" Color="#52787880" />
    <SolidColorBrush x:Key="OaFooterBrush" Color="#8032323A" />
    <SolidColorBrush x:Key="OaDangerBrush" Color="#FF453A" />
    <SolidColorBrush x:Key="OaSuccessBrush" Color="#30D158" />
    <SolidColorBrush x:Key="OaPillTextBrush" Color="#E5E5EA" />

    <!-- 关键词提示胶囊 -->
    <Style x:Key="OaPillStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource OaPillBrush}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Margin" Value="0,0,8,8" />
    </Style>

</ResourceDictionary>
