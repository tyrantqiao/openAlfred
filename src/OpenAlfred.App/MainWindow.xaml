<ui:FluentWindow x:Class="OpenAlfred.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:core="clr-namespace:OpenAlfred.Core;assembly=OpenAlfred.Core"
        Title="openAlfred"
        Topmost="True"
        Width="640" SizeToContent="Height" MaxHeight="640"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI">

    <Window.Resources>
        <!-- 结果行模板 -->
        <DataTemplate x:Key="ResultItemTemplate" DataType="{x:Type core:QueryResult}">
            <Grid Margin="10,9" x:Name="RowRoot">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                        Background="{DynamicResource OaPillBrush}" Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <Grid>
                        <ui:SymbolIcon x:Name="Icon" FontSize="20"
                                       Foreground="{DynamicResource OaTextPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Symbol="Search24" />
                        <Image x:Name="Thumb" Width="40" Height="40"
                               Stretch="UniformToFill" Visibility="Collapsed"
                               Source="{Binding ImagePath, Converter={StaticResource PathToImage}}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource OaTextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Preview}" FontSize="12.5" Margin="0,2,0,0"
                               Foreground="{DynamicResource OaTextSecondaryBrush}"
                               TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Preview, Converter={StaticResource StringToVisibilityConverter}}" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Margin="0,2,0,0"
                               Foreground="{DynamicResource OaTextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxHeight="36"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Error}" FontSize="12.5" Margin="0,2,0,0"
                               Foreground="{DynamicResource OaDangerBrush}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Error, Converter={StaticResource StringToVisibilityConverter}}" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding Meta}" FontSize="11.5"
                           Foreground="{DynamicResource OaTextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="12,0,4,0" TextAlignment="Right" />
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Thumb" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="calc">
                    <Setter TargetName="Icon" Property="Symbol" Value="Calculator24" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="clip">
                    <Setter TargetName="Icon" Property="Symbol" Value="ClipboardTextLtr24" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="app">
                    <Setter TargetName="Icon" Property="Symbol" Value="AppGeneric24" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="file">
                    <Setter TargetName="Icon" Property="Symbol" Value="DocumentText24" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="json">
                    <Setter TargetName="Icon" Property="Symbol" Value="CodeCircle24" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="time">
                    <Setter TargetName="Icon" Property="Symbol" Value="Clock24" />
                </DataTrigger>
                <!-- 计算器主结果：大号蓝色数字 -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Source}" Value="calc" />
                        <Condition Binding="{Binding Error}" Value="{x:Null}" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="RowRoot" Property="Margin" Value="10,14" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{DynamicResource OaWindowBrush}"
            BorderBrush="{DynamicResource OaWindowBorderBrush}" BorderThickness="1"
            CornerRadius="18" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 搜索行 -->
            <Grid Grid.Row="0" Margin="22,20,22,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Grid.Column="0" Symbol="Search24" FontSize="22"
                               Foreground="{DynamicResource OaTextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                <ui:TextBox x:Name="SearchBox" Grid.Column="1"
                            Background="Transparent" BorderThickness="0"
                            FontSize="21" Padding="0"
                            Foreground="{DynamicResource OaTextPrimaryBrush}"
                            PlaceholderText="输入关键词或算式…"
                            CaretBrush="{DynamicResource OaAccentBrush}"
                            MaxLength="4000"
                            TextChanged="SearchBox_TextChanged" />
                <!-- 最小化到托盘 -->
                <ui:Button x:Name="MinButton" Grid.Column="2" Icon="ArrowMinimize24"
                           Appearance="Transparent" FontSize="15"
                           Foreground="{DynamicResource OaTextSecondaryBrush}"
                           VerticalAlignment="Center" Padding="6"
                           ToolTip="最小化（常驻后台）"
                           Click="MinButton_Click" />
            </Grid>

            <!-- 分隔线 -->
            <Border x:Name="QueryDivider" Grid.Row="1" Height="1"
                    Background="{DynamicResource OaSeparatorBrush}" Visibility="Collapsed" />

            <!-- 结果列表 -->
            <ListBox x:Name="ResultsList" Grid.Row="2" Margin="10,8,10,12"
                     Background="Transparent" BorderThickness="0"
                     ItemTemplate="{StaticResource ResultItemTemplate}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     Visibility="Collapsed"
                     PreviewMouseLeftButtonUp="ResultsList_MouseUp">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <!-- 拷贝成功时闪现的强调色底衬，独立于选中/悬停触发器 -->
                                        <Border x:Name="CopyFlash" CornerRadius="12"
                                                Background="{DynamicResource OaAccentBrush}"
                                                Opacity="0" IsHitTestVisible="False" />
                                        <Border x:Name="Bd" CornerRadius="12" Background="Transparent"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource OaSelectedBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background"
                                                    Value="{DynamicResource OaHoverBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- 空状态关键词提示条 -->
            <StackPanel x:Name="HintBar" Grid.Row="3" Margin="22,0,22,14">
                <Border Height="1" Background="{DynamicResource OaSeparatorBrush}" Margin="0,0,0,14" />
                <WrapPanel x:Name="PillRow" />
            </StackPanel>

            <!-- 底部提示条 -->
            <Border Grid.Row="4" Background="{DynamicResource OaFooterBrush}" Padding="22,11">
                <Grid>
                    <TextBlock x:Name="FooterLeft" Text="↑↓ 选择 · Enter 执行 · Tab 补全"
                               FontSize="12" Foreground="{DynamicResource OaTextSecondaryBrush}" />
                    <TextBlock x:Name="FooterRight" Text="Esc 关闭" FontSize="12"
                               Foreground="{DynamicResource OaTextSecondaryBrush}"
                               HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
